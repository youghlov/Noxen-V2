{
  "entities": {
    "ContactSubmission": {
      "title": "Contact Submission",
      "description": "A contact form submission from a user",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name or company of sender" },
        "email": { "type": "string", "description": "Email address of sender" },
        "services": { "type": "array", "items": { "type": "string" }, "description": "Selected services" },
        "project": { "type": "string", "description": "Project details" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "email", "services", "project", "createdAt"]
    },
    "QuoteRequest": {
      "title": "Quote Request",
      "description": "A quote request from a potential client",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "plan": { "type": "string" },
        "billing": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "email", "phone", "company", "plan", "billing", "message", "createdAt"]
    }
  },
  "firestore": {
    "contact_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ContactSubmission" },
      "description": "Collection of contact form submissions"
    },
    "quote_requests/{requestId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Collection of quote requests for plans"
    }
  }
}
