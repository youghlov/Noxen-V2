rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isValidContactSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'services', 'project', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 && data.email.matches('^.+@.+\\..+$') &&
             data.services is list && data.services.size() <= 10 && (data.services.size() == 0 || data.services[0] is string) &&
             data.project is string && data.project.size() <= 5000 &&
             data.createdAt == request.time;
    }

    match /contact_submissions/{submissionId} {
      // Allow anybody to create a contact submission
      allow create: if isValidId(submissionId) && isValidContactSubmission(incoming());
    }
  }
}
